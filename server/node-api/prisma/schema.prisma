generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// ENUMS
// =========================================================

enum CompanyType {
  SUPER_ADMIN
  PHARMA
  WHOLESALER
  RETAILER
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  DISPATCH
  RETURN
  EXPIRY
  DAMAGE
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ACCEPTED
  DECLINED
}

enum DispatchStatus {
  PENDING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ReturnReason {
  WRONG_QUANTITY_OR_MEDICINE
  DAMAGED_OR_DEFECTIVE
  EXPIRED_MEDICINE
  OTHER
}

enum ReturnRequestStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
  INSPECTING
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnInspectionStatus {
  PENDING
  INSPECTED
  REJECTED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
}

enum UserRole {
  SUPER_ADMIN
  PHARMA
  WHOLESALER
  RETAILER
}

// =========================================================
// INVOICE ENUM
// =========================================================

enum InvoiceStatus {
  DRAFT
  GENERATED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// =========================================================
// COMPANY
// =========================================================

model Company {
  id                String      @id @default(uuid())
  companyName       String
  companyType       CompanyType
  email             String      @unique
  passwordHash      String
  phone             String?
  gstNumber         String?     @unique
  drugLicenseNumber String?     @unique

  address String?
  city    String?
  state   String?
  pincode String?

  status     CompanyStatus @default(PENDING)
  isVerified Boolean       @default(false)

  warehouses Warehouse[]
  medicines  Medicine[]
  sales      Sale[]
  users      User[]
  documents  CompanyDocument[]

  // Purchase Orders
  purchaseOrdersAsBuyer  PurchaseOrder[] @relation("BuyerOrders")
  purchaseOrdersAsSeller PurchaseOrder[] @relation("SellerOrders")

  // Purchase Requests
  purchaseRequestsAsBuyer  PurchaseRequest[] @relation("BuyerRequests")
  purchaseRequestsAsSeller PurchaseRequest[] @relation("SellerRequests")

  // Return Requests
  returnsRequested ReturnRequest[] @relation("ReturnBuyer")
  returnsReceived  ReturnRequest[] @relation("ReturnSeller")

  // Customer Balances
  customerBalancesAsPharma     CustomerBalance[] @relation("PharmaBalances")
  customerBalancesAsWholesaler CustomerBalance[] @relation("WholesalerBalances")

  // Notifications
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationSender")

  // Invoices
  invoicesAsSeller Invoice[] @relation("InvoiceSeller")
  invoicesAsBuyer  Invoice[] @relation("InvoiceBuyer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// COMPANY DOCUMENT
// =========================================================

model CompanyDocument {
  id String @id @default(uuid())

  companyId    String
  documentType String

  fileName String?
  fileUrl  String?

  status DocumentStatus @default(PENDING)

  rejectionReason String?

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// =========================================================
// WAREHOUSE
// =========================================================

model Warehouse {
  id            String @id @default(uuid())
  companyId     String
  warehouseName String

  address String?
  city    String?
  state   String?
  pincode String?

  company Company @relation(fields: [companyId], references: [id])

  inventory Inventory[]
  sales     Sale[]

  // Dispatch
  sourceDispatches      Dispatch[] @relation("SourceWarehouse")
  destinationDispatches Dispatch[] @relation("DestinationWarehouse")

  // Invoice
  sourceInvoices      Invoice[] @relation("InvoiceSourceWarehouse")
  destinationInvoices Invoice[] @relation("InvoiceDestinationWarehouse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// CATEGORY
// =========================================================

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  medicines Medicine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// MEDICINE
// =========================================================

model Medicine {
  id         String @id @default(uuid())
  companyId  String
  categoryId String

  medicineName String
  genericName  String?
  strength     String
  dosageForm   String
  description  String?
  isActive     Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])

  category Category @relation(fields: [categoryId], references: [id])

  batches              MedicineBatch[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseRequestItems PurchaseRequestItem[]

  // Invoice items
  invoiceItems InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// MEDICINE BATCH
// =========================================================

model MedicineBatch {
  id         String @id @default(uuid())
  medicineId String

  batchNumber       String
  manufacturingDate DateTime
  expiryDate        DateTime

  mrp      Decimal
  quantity Int

  medicine Medicine @relation(fields: [medicineId], references: [id])

  inventory            Inventory[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseRequestItems PurchaseRequestItem[]
  dispatchItems        DispatchItem[]
  saleItems            SaleItem[]

  // Invoice items
  invoiceItems InvoiceItem[]
  returnItems ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([medicineId, batchNumber])
}

// =========================================================
// INVENTORY
// =========================================================

model Inventory {
  id          String @id @default(uuid())
  warehouseId String
  batchId     String
  quantity    Int    @default(0)
  quarantineQuantity Int @default(0)
  defectiveQuantity  Int @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  batch MedicineBatch @relation(fields: [batchId], references: [id])

  transactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, batchId])
}

// =========================================================
// INVENTORY TRANSACTION
// =========================================================

model InventoryTransaction {
  id          String @id @default(uuid())
  inventoryId String

  type     InventoryTransactionType
  quantity Int

  referenceId String?
  notes       String?

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  createdAt DateTime @default(now())
}

// =========================================================
// PURCHASE REQUEST
// =========================================================

model PurchaseRequest {
  id String @id @default(uuid())

  requestNumber String @unique

  buyerCompanyId  String
  sellerCompanyId String

  status PurchaseRequestStatus @default(PENDING)

  requestedDate         DateTime  @default(now())
  preferredDeliveryDate DateTime?
  requirement           String?

  buyerCompany Company @relation("BuyerRequests", fields: [buyerCompanyId], references: [id])

  sellerCompany Company @relation("SellerRequests", fields: [sellerCompanyId], references: [id])

  items PurchaseRequestItem[]

  purchaseOrder PurchaseOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerCompanyId])
  @@index([sellerCompanyId])
  @@index([status])
}

// =========================================================
// PURCHASE REQUEST ITEM
// =========================================================

model PurchaseRequestItem {
  id String @id @default(uuid())

  purchaseRequestId String
  medicineId        String

  requestedQuantity Int
  approvedQuantity  Int?

  unitPrice Decimal?
  batchId   String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  medicine Medicine @relation(fields: [medicineId], references: [id])

  batch MedicineBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseRequestId])
  @@index([medicineId])
  @@index([batchId])
}

// =========================================================
// PURCHASE ORDER
// =========================================================

model PurchaseOrder {
  id          String @id @default(uuid())
  orderNumber String @unique

  purchaseRequestId String? @unique

  buyerCompanyId  String
  sellerCompanyId String

  status PurchaseOrderStatus @default(PENDING)

  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  notes        String?

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])

  buyerCompany Company @relation("BuyerOrders", fields: [buyerCompanyId], references: [id])

  sellerCompany Company @relation("SellerOrders", fields: [sellerCompanyId], references: [id])

  items      PurchaseOrderItem[]
  dispatches Dispatch[]

  // One purchase order → one invoice
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// PURCHASE ORDER ITEM
// =========================================================

model PurchaseOrderItem {
  id String @id @default(uuid())

  purchaseOrderId String
  medicineId      String
  batchId         String?

  // Original quantity requested by wholesaler
  requestedQuantity Int

  // Current approved quantity
  quantity Int

  unitPrice  Decimal
  totalPrice Decimal

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  medicine Medicine @relation(fields: [medicineId], references: [id])

  batch MedicineBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// DISPATCH
// =========================================================

model Dispatch {
  id              String @id @default(uuid())
  purchaseOrderId String

  sourceWarehouseId      String
  destinationWarehouseId String

  status       DispatchStatus @default(PENDING)
  dispatchedAt DateTime?
  deliveredAt  DateTime?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  sourceWarehouse Warehouse @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])

  destinationWarehouse Warehouse @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  items DispatchItem[]
  returns ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// DISPATCH ITEM
// =========================================================

model DispatchItem {
  id         String @id @default(uuid())
  dispatchId String
  batchId    String

  quantity Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id])

  batch MedicineBatch @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// SALE
// =========================================================

model Sale {
  id            String @id @default(uuid())
  invoiceNumber String @unique

  companyId   String
  warehouseId String

  status   SaleStatus @default(COMPLETED)
  saleDate DateTime   @default(now())

  totalAmount Decimal

  notes String?

  company Company @relation(fields: [companyId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// SALE ITEM
// =========================================================

model SaleItem {
  id String @id @default(uuid())

  saleId  String
  batchId String

  quantity   Int
  unitPrice  Decimal
  totalPrice Decimal

  sale Sale @relation(fields: [saleId], references: [id])

  batch MedicineBatch @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// USER
// =========================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  companyId String?

  company Company? @relation(fields: [companyId], references: [id])

  isActive Boolean @default(true)

  settings UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// USER SETTINGS
// =========================================================

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique

  emailNotifications    Boolean @default(true)
  approvalNotifications Boolean @default(true)
  systemAlerts          Boolean @default(true)

  language String @default("English")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// CUSTOMER BALANCE
// =========================================================

model CustomerBalance {
  id String @id @default(uuid())

  pharmaCompanyId     String
  wholesalerCompanyId String

  totalAmount Decimal @default(0)
  paidAmount  Decimal @default(0)

  pharmaCompany Company @relation("PharmaBalances", fields: [pharmaCompanyId], references: [id])

  wholesalerCompany Company @relation("WholesalerBalances", fields: [wholesalerCompanyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pharmaCompanyId, wholesalerCompanyId])
  @@index([pharmaCompanyId])
  @@index([wholesalerCompanyId])
}

// =========================================================
// NOTIFICATION
// =========================================================

model Notification {
  id String @id @default(uuid())

  recipientCompanyId String
  senderCompanyId    String

  title   String
  message String
  type    String @default("GENERAL")

  isRead Boolean @default(false)

  recipientCompany Company @relation("NotificationRecipient", fields: [recipientCompanyId], references: [id])

  senderCompany Company @relation("NotificationSender", fields: [senderCompanyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientCompanyId])
  @@index([senderCompanyId])
  @@index([recipientCompanyId, isRead])
}

// =========================================================
// INVOICE
// =========================================================

model Invoice {
  id String @id @default(uuid())

  invoiceNumber String @unique

  // One invoice belongs to one purchase order
  purchaseOrderId String @unique

  // Seller = Pharma company
  sellerCompanyId String

  // Buyer = Wholesaler
  buyerCompanyId String

  // Warehouse traceability
  sourceWarehouseId      String?
  destinationWarehouseId String?

  // Invoice dates
  invoiceDate DateTime  @default(now())
  dueDate     DateTime?

  // GST / payment information
  placeOfSupply String?
  paymentTerms  String?

  status InvoiceStatus @default(DRAFT)

  // Financial values
  subtotal       Decimal @default(0)
  discountAmount Decimal @default(0)
  taxableAmount  Decimal @default(0)

  cgstAmount Decimal @default(0)
  sgstAmount Decimal @default(0)
  igstAmount Decimal @default(0)

  totalGst    Decimal @default(0)
  totalAmount Decimal @default(0)

  paidAmount Decimal @default(0)
  balanceDue Decimal @default(0)

  // Purchase Order
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  // Pharma
  sellerCompany Company @relation("InvoiceSeller", fields: [sellerCompanyId], references: [id])

  // Wholesaler
  buyerCompany Company @relation("InvoiceBuyer", fields: [buyerCompanyId], references: [id])

  // Source warehouse
  sourceWarehouse Warehouse? @relation("InvoiceSourceWarehouse", fields: [sourceWarehouseId], references: [id])

  // Destination warehouse
  destinationWarehouse Warehouse? @relation("InvoiceDestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  // Invoice items
  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
}

// =========================================================
// INVOICE ITEM
// =========================================================

model InvoiceItem {
  id String @id @default(uuid())

  invoiceId  String
  medicineId String
  batchId    String

  quantity Int
  unit     String

  unitPrice Decimal

  discountPercent Decimal @default(0)

  taxableValue Decimal @default(0)

  gstPercent Decimal @default(0)
  gstAmount  Decimal @default(0)

  amount Decimal @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  medicine Medicine @relation(fields: [medicineId], references: [id])

  batch MedicineBatch @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([medicineId])
  @@index([batchId])
}

// =========================================================
// MEDICINE RETURN REQUEST
// =========================================================

model ReturnRequest {
  id String @id @default(uuid())

  // Original delivered dispatch
  dispatchId String

  // Companies involved in the original transaction
  buyerCompanyId  String
  sellerCompanyId String

  // Return workflow status
  status ReturnRequestStatus @default(REQUESTED)

  // Optional notes for the return request
  notes String?

  // Workflow timestamps
  receivedAt  DateTime?
  inspectedAt DateTime?
  completedAt DateTime?

  // Relationships
  dispatch      Dispatch @relation(fields: [dispatchId], references: [id])
  buyerCompany  Company  @relation("ReturnBuyer", fields: [buyerCompanyId], references: [id])
  sellerCompany Company  @relation("ReturnSeller", fields: [sellerCompanyId], references: [id])

  // Returned medicines and batches
  items ReturnItem[]

  // Audit timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query indexes
  @@index([dispatchId])
  @@index([buyerCompanyId])
  @@index([sellerCompanyId])
  @@index([status])
}

// =========================================================
// MEDICINE RETURN ITEM
// =========================================================

model ReturnItem {
  id String @id @default(uuid())

  returnRequestId String
  batchId         String

  // Quantity the buyer is requesting to return
  quantity Int

  // Reason selected by the buyer
  reason ReturnReason
  description String?

  // Inspection progress
  inspectionStatus ReturnInspectionStatus @default(PENDING)

  // Final quantity breakdown, recorded during inspection
  acceptedQuantity    Int @default(0)
  defectiveQuantity   Int @default(0)
  expiredQuantity     Int @default(0)
  quarantinedQuantity Int @default(0)

  notes String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId],references: [id],onDelete: Cascade)

  batch MedicineBatch @relation(fields: [batchId],references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([returnRequestId])
  @@index([batchId])
  @@index([inspectionStatus])
}